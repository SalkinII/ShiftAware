# ShiftAware Environment Variables
# Copy this file to .env.local for local development
# For production, set these in your deployment environment

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For local dev with Docker: use localhost:45432 (host port)
# For Docker container: use db:5432 (service name)
DATABASE_URL=postgresql://shiftaware:shiftaware@localhost:45432/shiftaware_dev

# ============================================================================
# Authentication
# ============================================================================
# Session signing secret (64+ hex chars recommended).
# Auto-generated in dev if missing. MUST be set in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Password options (choose ONE approach) ---

# Option A: Hashed passwords (recommended for production)
# Generate with: npx tsx scripts/hash-password.ts
# Format: salt:scrypthash (hex)
ADMIN_PASSWORD_HASH=
# USER_PASSWORD_HASH=

# Option B: Plain-text passwords (dev only, logs a warning)
ADMIN_PASSWORD=Admin123!
# USER_PASSWORD=

# Session timeout in minutes (default: 60)
SESSION_TIMEOUT_MINUTES=60

# ============================================================================
# Application Configuration
# ============================================================================
# Node environment: development | production
NODE_ENV=development

# ============================================================================
# Port Configuration (for reference - set in docker-compose.yml)
# ============================================================================
# App port: 43000 (host) -> 3000 (container)
# Postgres port: 45432 (host) -> 5432 (container)
# Optional Python compute: 43010 (host) -> 8000 (container)
